cno'=-phos(cno,cnop,kkc,tau,1)+dephos(cno,cnop,tau)+kt*phin/Acytoc-cno*Acytoc*(kt*phin/Acytoc+kt*phic/Acytoc-knt*cnop)
cnop'=phos(cno,cnop,kkc,tau,1)-dephos(cno,cnop,tau)-knt*cnop-cnop*Acytoc*(kt*phin/Acytoc+kt*phic/Acytoc-knt*cnop)
ccy'=kt*phic/Acytoc-ccy*Acytoc*(kt*phin/Acytoc+kt*phic/Acytoc-knt*cnop)
NCcyto'=knt*cnop/(cno+cnop+ccy)-(kt*phin/Acytoc+kt*phic/Acytoc-knt*cnop)/(cno+cnop+ccy)*NCcyto
phos(cno,cnop,kkc,tau,scale)=scale*(1/tau)*(cno+cnop)^(n+1)/((cno+cnop)^n+(threshold(kkc,cnop))^n)
dephos(cno,cnop,tau)=(1/tau)*cnop
threshold(kkc,cnop)=kkc*(5/4-(5/4-1/8)*(cnop/kkc)^nthr/((cnop/kkc)^nthr+(9/64)^nthr))
# param kkc=1.35
param kkc=1
# param kkc=1e-1
# param tau=1e-2
# param tau=1e-1
param tau=5e-1
# param tau=1
# param tau=1e1
# param tau=3e1
# param tau=5e1
# param tau=7e1
# param knt=6e-1
# param knt=4e-1
# param knt=2e-1
param knt=1e-1
# param knt=5e-2
# param knt=1e-2
# param knt=5e-3
param kt=0.005,phin=0.08,phic=0.92,Anc=1e-2,Acytoc=1e-2
param nthr=3
# param n=10
param n=5
cno(0)=1
cnop(0)=1
ccy(0)=1
NCcyto(0)=0.08
@ METHOD=stiff
# @ TOTAL=100
# @ TOTAL=200
# @ TOTAL=500
# @ TOTAL=1000
@ TOTAL=2000
# @ TOTAL=10000
# @ DT=1e-5
# @ DT=1e-4
@ DT=1e-3
@ BOUNDS=1e4
@ MAXSTOR=1000000
done
